title = "Ghostty"
# Font configuration
font-family = "JetBrains Mono Nerd Font"
font-size = 20

# Window settings
window-padding-x = 6
window-padding-y = 6
window-height = 24
window-width = 80 
window-decoration = false
background-opacity = 0.85
background-blur = true
quit-after-last-window-closed = true
# Terminal settings
term = xterm-256color

# Keybindings
keybind = f11=toggle_fullscreen

# Themes
theme = TokyoNight
